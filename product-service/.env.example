# MongoDB Atlas connection string for product-service
# Get this from your MongoDB Atlas project > Connect > Drivers
MONGO_PRODUCT_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# Sao chép thành .env và điền giá trị. Không commit file .env.

CONFIG_SERVER_URI=http://localhost:8888

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka
