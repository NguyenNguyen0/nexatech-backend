MONGO_PRODUCT_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexatech_products

# Chỉ dùng khi chạy trực tiếp (không qua start-ec2.ps1).
# Khi dùng `make run-product-ec2`, infra (config-server, eureka, redis, kafka) lấy từ .env.ec2
CONFIG_SERVER_URI=http://localhost:8888
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

PRODUCT_INTERNAL_API_KEY=change-me

# AWS S3 — upload ảnh/video đánh giá sản phẩm
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
