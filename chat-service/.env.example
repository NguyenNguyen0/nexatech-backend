# Sao chép thành .env và điền giá trị. Không commit file .env.

CONFIG_SERVER_URI=http://localhost:8888

EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

DB_URL=jdbc:postgresql://localhost:5432/nexatech_chats
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

MONGO_CHAT_URL=mongodb://your_user:your_password@localhost:27017/nexatech_chats?authSource=admin

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
