{
  "info": {
    "name": "NexaTech — Cart + Order + Payment (Local Test)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Bộ sưu tập API để test Cart, Checkout, Order, Payment trên môi trường local.\n\nCách chạy:\n1. `docker compose -f docker-compose-local.yml up -d`\n2. Chạy order-service (port 8084) và payment-service (port 8086) với profile test\n3. Import collection này vào Postman, chọn environment \"NexaTech Local\"\n4. Chạy lần lượt các request"
  },
  "variable": [
    {
      "key": "ORDER_BASE",
      "value": "http://localhost:8084"
    },
    {
      "key": "PAYMENT_BASE",
      "value": "http://localhost:8086"
    },
    {
      "key": "USER_ID",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "PRODUCT_ID_1",
      "value": "product-001"
    },
    {
      "key": "PRODUCT_ID_2",
      "value": "product-002"
    },
    {
      "key": "ORDER_ID",
      "value": ""
    },
    {
      "key": "ORDER_NUMBER",
      "value": ""
    },
    {
      "key": "PAYMENT_ID",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Cart",
      "item": [
        {
          "name": "1.1 Get Cart (empty)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" }
            ],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/cart",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "cart"]
            }
          }
        },
        {
          "name": "1.2 Add Item 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Item added', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.data.items.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{PRODUCT_ID_1}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/cart/items",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "1.3 Add Item 2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{PRODUCT_ID_2}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/cart/items",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "1.4 Get Cart (with items)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cart has 2 items', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.items.length).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" }
            ],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/cart",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "cart"]
            }
          }
        },
        {
          "name": "1.5 Update Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            },
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/cart/items/{{PRODUCT_ID_1}}",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "cart", "items", "{{PRODUCT_ID_1}}"]
            }
          }
        },
        {
          "name": "1.6 Remove Item 2",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" }
            ],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/cart/items/{{PRODUCT_ID_2}}",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "cart", "items", "{{PRODUCT_ID_2}}"]
            }
          }
        },
        {
          "name": "1.7 Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" }
            ],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/cart",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "cart"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Checkout (COD)",
      "item": [
        {
          "name": "2.1 Add items to cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{PRODUCT_ID_1}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/cart/items",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "2.2 Checkout COD",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.success && body.data) {",
                  "  pm.collectionVariables.set('ORDER_ID', body.data.orderId);",
                  "  pm.collectionVariables.set('ORDER_NUMBER', body.data.orderNumber);",
                  "  if (body.data.paymentId) pm.collectionVariables.set('PAYMENT_ID', body.data.paymentId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"123 Nguyen Hue, Q1, TP.HCM\",\n  \"shippingMethod\": \"STANDARD\",\n  \"paymentMethod\": \"COD\",\n  \"note\": \"Giao giờ hành chính\"\n}"
            },
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/checkout",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "checkout"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Checkout (VNPay)",
      "item": [
        {
          "name": "3.1 Add items to cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{PRODUCT_ID_1}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/cart/items",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "3.2 Checkout VNPay",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.success && body.data) {",
                  "  pm.collectionVariables.set('ORDER_ID', body.data.orderId);",
                  "  pm.collectionVariables.set('ORDER_NUMBER', body.data.orderNumber);",
                  "  if (body.data.paymentId) pm.collectionVariables.set('PAYMENT_ID', body.data.paymentId);",
                  "  if (body.data.paymentUrl) console.log('VNPay URL:', body.data.paymentUrl);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"456 Le Loi, Q3, TP.HCM\",\n  \"shippingMethod\": \"EXPRESS\",\n  \"paymentMethod\": \"VNPAY\",\n  \"note\": \"\"\n}"
            },
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/checkout",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "checkout"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Orders",
      "item": [
        {
          "name": "4.1 Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" }
            ],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/orders/my?page=0&size=10&sort=createdAt,desc",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "orders", "my"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "createdAt,desc" }
              ]
            }
          }
        },
        {
          "name": "4.2 Get Order by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" }
            ],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/orders/{{ORDER_ID}}",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "orders", "{{ORDER_ID}}"]
            }
          }
        },
        {
          "name": "4.3 Get All Orders (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/orders?page=0&size=20",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "4.4 Update Order Status (admin)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/orders/{{ORDER_ID}}/status?status=CONFIRMED",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "orders", "{{ORDER_ID}}", "status"],
              "query": [
                { "key": "status", "value": "CONFIRMED" }
              ]
            }
          }
        },
        {
          "name": "4.5 Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" }
            ],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/orders/{{ORDER_ID}}/cancel",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "orders", "{{ORDER_ID}}", "cancel"]
            }
          }
        },
        {
          "name": "4.6 Update Shipping (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"GHN123456789\",\n  \"carrierName\": \"GHN\",\n  \"estimatedDelivery\": null\n}"
            },
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/admin/orders/{{ORDER_ID}}/shipping",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "admin", "orders", "{{ORDER_ID}}", "shipping"]
            }
          }
        },
        {
          "name": "4.7 Get Order Stats (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ORDER_BASE}}/api/v1/admin/orders/stats?from=2024-01-01&to=2025-12-31",
              "host": ["{{ORDER_BASE}}"],
              "path": ["api", "v1", "admin", "orders", "stats"],
              "query": [
                { "key": "from", "value": "2024-01-01" },
                { "key": "to", "value": "2025-12-31" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Payments",
      "item": [
        {
          "name": "5.1 Get Payment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{PAYMENT_BASE}}/api/v1/payments/{{PAYMENT_ID}}",
              "host": ["{{PAYMENT_BASE}}"],
              "path": ["api", "v1", "payments", "{{PAYMENT_ID}}"]
            }
          }
        },
        {
          "name": "5.2 Get Payment by Order ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{PAYMENT_BASE}}/api/v1/payments/order/{{ORDER_ID}}",
              "host": ["{{PAYMENT_BASE}}"],
              "path": ["api", "v1", "payments", "order", "{{ORDER_ID}}"]
            }
          }
        },
        {
          "name": "5.3 Get My Payments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" }
            ],
            "url": {
              "raw": "{{PAYMENT_BASE}}/api/v1/payments/my?page=0&size=10",
              "host": ["{{PAYMENT_BASE}}"],
              "path": ["api", "v1", "payments", "my"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "5.4 Create Payment (manual)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{ORDER_ID}}\",\n  \"amount\": 100000,\n  \"method\": \"COD\"\n}"
            },
            "url": {
              "raw": "{{PAYMENT_BASE}}/api/v1/payments",
              "host": ["{{PAYMENT_BASE}}"],
              "path": ["api", "v1", "payments"]
            }
          }
        },
        {
          "name": "5.5 Create VNPay URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{USER_ID}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{ORDER_ID}}\",\n  \"amount\": 100000,\n  \"orderInfo\": \"Thanh toan don hang test\"\n}"
            },
            "url": {
              "raw": "{{PAYMENT_BASE}}/api/v1/payments/vnpay/create",
              "host": ["{{PAYMENT_BASE}}"],
              "path": ["api", "v1", "payments", "vnpay", "create"]
            }
          }
        },
        {
          "name": "5.6 Refund Payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{PAYMENT_BASE}}/api/v1/payments/{{PAYMENT_ID}}/refund",
              "host": ["{{PAYMENT_BASE}}"],
              "path": ["api", "v1", "payments", "{{PAYMENT_ID}}", "refund"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Health Checks",
      "item": [
        {
          "name": "Order Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ORDER_BASE}}/actuator/health",
              "host": ["{{ORDER_BASE}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Payment Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{PAYMENT_BASE}}/actuator/health",
              "host": ["{{PAYMENT_BASE}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    }
  ]
}
