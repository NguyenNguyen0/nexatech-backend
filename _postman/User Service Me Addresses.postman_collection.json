{
  "info": {
    "_postman_id": "d17e2e80-3f91-40d1-8f85-a4c8f18be700",
    "name": "User Service - Users + My Addresses",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full API test for user-service: /users CRUD and /users/me/addresses flow, with auto variable scripts."
  },
  "variable": [
    { "key": "identityBaseUrl", "value": "http://localhost:8082" },
    { "key": "userBaseUrl", "value": "http://localhost:8083" },
    { "key": "username", "value": "nvminh162" },
    { "key": "password", "value": "123456789" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "myUserId", "value": "" },
    { "key": "managedUserId", "value": "" },
    { "key": "managedUsername", "value": "api_user_001" },
    { "key": "managedEmail", "value": "api_user_001@nexatech.local" },
    { "key": "addressId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Login (auto token + myUserId)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const result = body.result || {};",
              "const accessToken = result.access_token || result.accessToken || '';",
              "const refreshToken = result.refresh_token || result.refreshToken || '';",
              "if (accessToken) {",
              "  pm.collectionVariables.set('accessToken', accessToken);",
              "  const parts = accessToken.split('.');",
              "  if (parts.length === 3) {",
              "    const payload = JSON.parse(atob(parts[1].replace(/-/g, '+').replace(/_/g, '/')));",
              "    if (payload.sub) pm.collectionVariables.set('myUserId', payload.sub);",
              "  }",
              "}",
              "if (refreshToken) pm.collectionVariables.set('refreshToken', refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{identityBaseUrl}}/auth/login"
      }
    },
    {
      "name": "1. Users",
      "item": [
        {
          "name": "1.1 createUser (auto managedUserId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const id = body?.result?.id;",
                  "if (id) pm.collectionVariables.set('managedUserId', id);",
                  "if (body?.result?.username) pm.collectionVariables.set('managedUsername', body.result.username);",
                  "if (body?.result?.email) pm.collectionVariables.set('managedEmail', body.result.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{managedEmail}}\",\n  \"username\": \"{{managedUsername}}\",\n  \"firstName\": \"API\",\n  \"lastName\": \"User\",\n  \"avatarUrl\": \"https://example.com/avatar.png\",\n  \"phone\": \"0911222333\",\n  \"dob\": \"1999-12-31\",\n  \"gender\": \"MALE\",\n  \"password\": \"123456789\",\n  \"onBoarded\": false\n}"
            },
            "url": "{{userBaseUrl}}/users"
          }
        },
        {
          "name": "1.2 getAllUsers (auto managedUserId by username)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const arr = pm.response.json()?.result;",
                  "if (Array.isArray(arr)) {",
                  "  const target = arr.find(x => x.username === pm.collectionVariables.get('managedUsername'));",
                  "  if (target?.id) pm.collectionVariables.set('managedUserId', target.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{userBaseUrl}}/users"
          }
        },
        {
          "name": "1.3 getUserById",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{userBaseUrl}}/users/{{managedUserId}}"
          }
        },
        {
          "name": "1.4 updateUser",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{managedEmail}}\",\n  \"firstName\": \"API Updated\",\n  \"lastName\": \"User Updated\",\n  \"avatarUrl\": \"https://example.com/avatar-2.png\",\n  \"phone\": \"0900000000\",\n  \"dob\": \"2000-01-01\",\n  \"gender\": \"FEMALE\",\n  \"onBoarded\": true\n}"
            },
            "url": "{{userBaseUrl}}/users/{{managedUserId}}"
          }
        },
        {
          "name": "1.5 deleteUser (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{userBaseUrl}}/users/{{managedUserId}}"
          }
        }
      ]
    },
    {
      "name": "2. My Addresses",
      "item": [
        {
          "name": "2.1 createAddress",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const id = body?.result?.id;",
              "if (id) pm.collectionVariables.set('addressId', id);"
            ]
          }
        }
      ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverName\": \"Minh Nguyen\",\n  \"phone\": \"0912345678\",\n  \"province\": \"Ho Chi Minh\",\n  \"ward\": \"Ward 1\",\n  \"detail\": \"123 Nguyen Trai\",\n  \"latitude\": 10.7769,\n  \"longitude\": 106.7009,\n  \"addressType\": \"HOME\",\n  \"isDefault\": true\n}"
            },
            "url": "{{userBaseUrl}}/users/me/addresses"
          }
        },
        {
          "name": "2.2 findMyAddresses (auto addressId first)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const arr = body?.result;",
              "if (Array.isArray(arr) && arr.length > 0 && arr[0].id) pm.collectionVariables.set('addressId', arr[0].id);"
            ]
          }
        }
      ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{userBaseUrl}}/users/me/addresses"
          }
        },
        {
          "name": "2.3 findMyAddressById",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{userBaseUrl}}/users/me/addresses/{{addressId}}"
          }
        },
        {
          "name": "2.4 updateMyAddress",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverName\": \"Minh Nguyen Updated\",\n  \"phone\": \"0999999999\",\n  \"province\": \"Ho Chi Minh\",\n  \"ward\": \"Ward 7\",\n  \"detail\": \"456 Le Loi\",\n  \"latitude\": 10.782,\n  \"longitude\": 106.695,\n  \"addressType\": \"OFFICE\",\n  \"isDefault\": false\n}"
            },
            "url": "{{userBaseUrl}}/users/me/addresses/{{addressId}}"
          }
        },
        {
          "name": "2.5 setDefaultMyAddress",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{userBaseUrl}}/users/me/addresses/{{addressId}}/default"
          }
        },
        {
          "name": "2.6 deleteMyAddress",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{userBaseUrl}}/users/me/addresses/{{addressId}}"
          }
        }
      ]
    }
  ]
}
