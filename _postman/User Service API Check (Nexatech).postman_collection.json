    {
      "name": "0. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json()?.result || {};",
              "if (r.access_token) pm.collectionVariables.set('accessToken', r.access_token);",
              "if (r.refresh_token) pm.collectionVariables.set('refreshToken', r.refresh_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{identityBaseUrl}}/auth/login",
          "host": [
            "{{identityBaseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const t = pm.collectionVariables.get('accessToken');",
          "if (t && !pm.request.headers.has('Authorization')) pm.request.headers.add({ key: 'Authorization', value: `Bearer ${t}` });"
        ]
      }
    }
  ],
