        {
          "name": "register(user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"enabled\": true,\n  \"email\": \"{{registerEmail}}\",\n  \"emailVerified\": false,\n  \"firstName\": \"Minh\",\n  \"lastName\": \"Nguyen\",\n  \"phone\": \"0987654321\",\n  \"dob\": \"2000-01-01\",\n  \"gender\": \"MALE\",\n  \"onBoarded\": false,\n  \"credentials\": [\n    { \"type\": \"password\", \"value\": \"{{registerPassword}}\", \"temporary\": false }\n  ]\n}"
            },
            "url": {
              "raw": "{{identityBaseUrl}}/auth/register",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json()?.result || {}; if (r.access_token) pm.collectionVariables.set('accessToken', r.access_token); if (r.refresh_token) pm.collectionVariables.set('refreshToken', r.refresh_token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loginUsername}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{identityBaseUrl}}/auth/login",
              "host": [
                "{{identityBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
