{
	"info": {
		"_postman_id": "cart-checkout-test-collection",
		"name": "Cart + Checkout + Order Test",
		"description": "Test collection for S3-07 (Cart API), S3-09 (Checkout Flow), and related order/payment endpoints.\n\nPrerequisites:\n1. Run docker-compose-test.yml\n2. Wait for all services to be healthy\n3. Run requests in order (top to bottom)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8000" },
		{ "key": "identityUrl", "value": "http://localhost:8081" },
		{ "key": "accessToken", "value": "" },
		{ "key": "refreshToken", "value": "" },
		{ "key": "userId", "value": "" },
		{ "key": "productId", "value": "" },
		{ "key": "orderId", "value": "" },
		{ "key": "orderNumber", "value": "" },
		{ "key": "paymentId", "value": "" }
	],
	"item": [
		{
			"name": "0. Setup",
			"item": [
				{
					"name": "0.1 Health Check - Kong",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "http://localhost:8001/status", "host": ["http://localhost:8001"], "path": ["status"] }
					}
				},
				{
					"name": "0.2 Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"if (body.code === 1000 && body.result) {",
									"    pm.collectionVariables.set('accessToken', body.result.access_token);",
									"    pm.collectionVariables.set('refreshToken', body.result.refresh_token);",
									"    try {",
									"        const payload = JSON.parse(atob(body.result.access_token.split('.')[1]));",
									"        pm.collectionVariables.set('userId', payload.sub || payload.userId || '');",
									"    } catch(e) {}",
									"}",
									"pm.test('Register success', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testcart@nexatech.com\",\n  \"password\": \"Test@12345\",\n  \"fullName\": \"Cart Tester\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
					}
				},
				{
					"name": "0.3 Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"if (body.code === 1000 && body.result) {",
									"    pm.collectionVariables.set('accessToken', body.result.access_token);",
									"    pm.collectionVariables.set('refreshToken', body.result.refresh_token);",
									"    try {",
									"        const payload = JSON.parse(atob(body.result.access_token.split('.')[1]));",
									"        pm.collectionVariables.set('userId', payload.sub || payload.userId || '');",
									"    } catch(e) {}",
									"}",
									"pm.test('Login success', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testcart@nexatech.com\",\n  \"password\": \"Test@12345\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
					}
				}
			]
		},
		{
			"name": "1. Cart CRUD (S3-07)",
			"item": [
				{
					"name": "1.1 GET Cart (empty)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Cart is empty', () => {",
									"    pm.expect(body.success).to.be.true;",
									"    pm.expect(body.data.items).to.be.an('array').that.is.empty;",
									"    pm.expect(body.data.totalItems).to.equal(0);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
					}
				},
				{
					"name": "1.2 POST Add Item to Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Item added', () => {",
									"    pm.expect(body.success).to.be.true;",
									"    pm.expect(body.data.items.length).to.be.greaterThan(0);",
									"    pm.expect(body.data.totalItems).to.be.greaterThan(0);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items"] }
					}
				},
				{
					"name": "1.3 GET Cart (with items)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Cart has items', () => {",
									"    pm.expect(body.success).to.be.true;",
									"    pm.expect(body.data.items.length).to.be.greaterThan(0);",
									"    pm.expect(body.data.totalAmount).to.be.greaterThan(0);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
					}
				},
				{
					"name": "1.4 PUT Update Item Quantity",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Quantity updated', () => {",
									"    pm.expect(body.success).to.be.true;",
									"    const item = body.data.items.find(i => i.productId === pm.collectionVariables.get('productId'));",
									"    pm.expect(item.quantity).to.equal(3);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 3\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/cart/items/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items", "{{productId}}"] }
					}
				},
				{
					"name": "1.5 DELETE Remove Item",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Item removed', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/cart/items/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items", "{{productId}}"] }
					}
				},
				{
					"name": "1.6 DELETE Clear Cart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Cart cleared', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
					}
				}
			]
		},
		{
			"name": "2. Checkout COD (S3-09)",
			"item": [
				{
					"name": "2.1 Add Item (prepare for checkout)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items"] }
					}
				},
				{
					"name": "2.2 POST Checkout (COD)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Checkout COD success', () => {",
									"    pm.expect(body.success).to.be.true;",
									"    pm.expect(body.data.orderId).to.not.be.null;",
									"    pm.expect(body.data.orderNumber).to.not.be.null;",
									"    pm.expect(body.data.paymentMethod).to.equal('COD');",
									"    pm.expect(body.data.paymentUrl).to.be.null;",
									"});",
									"if (body.data) {",
									"    pm.collectionVariables.set('orderId', body.data.orderId);",
									"    pm.collectionVariables.set('orderNumber', body.data.orderNumber);",
									"    if (body.data.paymentId) pm.collectionVariables.set('paymentId', body.data.paymentId);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"shippingAddress\": \"123 Test Street, District 1, HCMC\",\n  \"shippingMethod\": \"STANDARD\",\n  \"paymentMethod\": \"COD\",\n  \"note\": \"Test order via Postman\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/checkout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "checkout"] }
					}
				},
				{
					"name": "2.3 GET Cart (should be empty after checkout)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Cart empty after checkout', () => {",
									"    pm.expect(body.data.items).to.be.an('array').that.is.empty;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
					}
				}
			]
		},
		{
			"name": "3. Checkout VNPay (S3-09)",
			"item": [
				{
					"name": "3.1 Add Item (for VNPay checkout)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items"] }
					}
				},
				{
					"name": "3.2 POST Checkout (VNPay)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Checkout VNPay success', () => {",
									"    pm.expect(body.success).to.be.true;",
									"    pm.expect(body.data.paymentMethod).to.equal('VNPAY');",
									"    pm.expect(body.data.paymentUrl).to.include('vnpayment.vn');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"shippingAddress\": \"456 VNPay Ave, District 3, HCMC\",\n  \"shippingMethod\": \"EXPRESS\",\n  \"paymentMethod\": \"VNPAY\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/checkout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "checkout"] }
					}
				}
			]
		},
		{
			"name": "4. Orders",
			"item": [
				{
					"name": "4.1 GET My Orders",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Has orders', () => {",
									"    pm.expect(body.success).to.be.true;",
									"    pm.expect(body.data.content.length).to.be.greaterThan(0);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/orders/my", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "my"] }
					}
				},
				{
					"name": "4.2 GET Order Detail",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Order detail', () => {",
									"    pm.expect(body.success).to.be.true;",
									"    pm.expect(body.data.id).to.equal(pm.collectionVariables.get('orderId'));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}"] }
					}
				},
				{
					"name": "4.3 GET Payment by Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Payment found', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/payments/order/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "order", "{{orderId}}"] }
					}
				},
				{
					"name": "4.4 POST Cancel Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Order cancelled', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "X-User-Id", "value": "{{userId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", "{{orderId}}", "cancel"] }
					}
				}
			]
		}
	]
}
