                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageUrl\": \"{{imageUrl}}\"\n}"
            },
            "url": {
              "raw": "{{productBaseUrl}}/api/v1/products/{{productId}}/images",
              "host": [
                "{{productBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}",
                "images"
              ]
            }
          },
          "response": []
        }
      ]
