{
  "info": {
    "_postman_id": "8a3d4f0a-219c-45b2-9e34-111111111111",
    "name": "Shipping Service API Check (Nexatech)",
    "description": "Test Shipping Service with Mock provider and GHN sandbox provider. To test GHN, start shipping-service with SHIPPING_PROVIDER=ghn and set GHN_TOKEN, GHN_SHOP_ID, GHN_FROM_DISTRICT_ID, GHN_FROM_WARD_CODE in the service environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Mock Provider",
      "description": "Use when shipping.provider=mock or SHIPPING_PROVIDER=mock.",
      "item": [
        {
          "name": "Calculate Fee - Mock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"ORDER-SHIP-MOCK-001\",\n  \"toDistrictId\": 1454,\n  \"toWardCode\": \"21211\",\n  \"customerProvince\": \"TP. Ho Chi Minh\",\n  \"customerDistrict\": \"Quan 1\",\n  \"customerWard\": \"Ben Nghe\",\n  \"customerAddress\": \"123 Nguyen Hue\",\n  \"weight\": 1800,\n  \"length\": 30,\n  \"width\": 20,\n  \"height\": 10,\n  \"insuranceValue\": 1000000,\n  \"serviceTypeId\": 2\n}"
            },
            "url": {
              "raw": "{{shippingBaseUrl}}/api/v1/shipping/fee",
              "host": [
                "{{shippingBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shipping",
                "fee"
              ]
            }
          }
        },
        {
          "name": "Create Shipment - Mock",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.trackingCode) {",
                  "  pm.environment.set('shippingTrackingCode', json.data.trackingCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
