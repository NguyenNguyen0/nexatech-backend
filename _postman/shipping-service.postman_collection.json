            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"ORDER-SHIP-MOCK-001\",\n  \"customerName\": \"Nguyen Van A\",\n  \"customerPhone\": \"0909123456\",\n  \"customerAddress\": \"123 Nguyen Hue\",\n  \"customerProvince\": \"TP. Ho Chi Minh\",\n  \"customerDistrict\": \"Quan 1\",\n  \"customerWard\": \"Ben Nghe\",\n  \"toDistrictId\": 1454,\n  \"toWardCode\": \"21211\",\n  \"weight\": 1800,\n  \"length\": 30,\n  \"width\": 20,\n  \"height\": 10,\n  \"codAmount\": 0,\n  \"insuranceValue\": 1000000,\n  \"serviceTypeId\": 2,\n  \"items\": [\n    {\n      \"name\": \"Laptop NexaTech\",\n      \"quantity\": 1,\n      \"price\": 15000000,\n      \"weight\": 1800,\n      \"length\": 30,\n      \"width\": 20,\n      \"height\": 10\n    }\n  ]\n}"
            },
