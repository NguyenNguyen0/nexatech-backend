{
  "info": {
    "name": "API Gateway — Identity Auth & User Service (Nexatech)",
    "description": "Gọi qua **API Gateway** (`api/v1/...`, port mặc định 8080).\n\nToken: **Login** → `accessToken` / `refreshToken` (script test giống collection cũ). Các request cần JWT: header **Authorization: Bearer {{accessToken}}**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a1b2c3d4-gateway-nexatech-identity-user"
  },
  "item": [
    {
      "name": "1. Auth (qua API Gateway)",
