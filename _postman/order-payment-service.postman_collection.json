{
  "info": {
    "name": "Nexatech - Order & Payment Service",
    "description": "Collection để test Order Service (port 8084) và Payment Service (port 8086). \nChạy theo thứ tự: tạo đơn hàng → tạo thanh toán → các thao tác khác.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "orderBaseUrl",
      "value": "http://localhost:8084",
      "description": "Base URL của Order Service"
    },
    {
      "key": "paymentBaseUrl",
      "value": "http://localhost:8086",
      "description": "Base URL của Payment Service"
    },
    {
      "key": "customerId",
      "value": "00000000-0000-0000-0000-000000000001",
      "description": "UUID của customer (truyền qua header X-User-Id, thay bằng UUID thật)"
    },
    {
      "key": "orderId",
      "value": "",
      "description": "Tự động set sau khi tạo đơn hàng (Create Order)"
    },
    {
      "key": "paymentId",
      "value": "",
      "description": "Tự động set sau khi tạo thanh toán (Create Payment)"
    },
    {
      "key": "productId1",
      "value": "PRODUCT-001",
      "description": "ID sản phẩm 1 (lấy từ product-service)"
    },
    {
      "key": "productId2",
      "value": "PRODUCT-002",
      "description": "ID sản phẩm 2 (lấy từ product-service)"
    }
  ],
  "item": [
    {
      "name": "Order Service",
      "description": "Tất cả endpoint của Order Service (port 8084)",
      "item": [
        {
          "name": "1. Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Tự động lưu orderId vào biến collection để dùng cho các request sau",
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('orderId', res.data.id);",
                  "    console.log('orderId đã được set:', res.data.id);",
                  "}",
                  "",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response có data', () => {",
                  "    pm.expect(res.data).to.not.be.null;",
                  "    pm.expect(res.data.orderNumber).to.match(/^ORD-/);",
                  "    pm.expect(res.data.status).to.equal('PENDING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{customerId}}", "description": "UUID của customer đặt hàng" }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId1}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{productId2}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": \"123 Nguyễn Huệ, Quận 1, TP.HCM\",\n  \"note\": \"Giao buổi sáng trước 10h\"\n}"
            }
          }
        },
        {
          "name": "2. Get Order by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response chứa thông tin đơn hàng', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.id).to.equal(pm.collectionVariables.get('orderId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "3. Get My Orders (phân trang)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response có dạng page', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data).to.have.property('content');",
                  "    pm.expect(res.data).to.have.property('totalElements');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{customerId}}", "description": "UUID của customer" }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders/my?page=0&size=10&sort=createdAt,desc",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders", "my"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "createdAt,desc" }
              ]
            }
          }
        },
        {
          "name": "4. Get All Orders (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response có dạng page', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data).to.have.property('content');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders?page=0&size=10",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "5. Update Order Status → CONFIRMED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Status đã được cập nhật', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.status).to.equal('CONFIRMED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders/{{orderId}}/status?status=CONFIRMED",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "status"],
              "query": [
                {
                  "key": "status",
                  "value": "CONFIRMED",
                  "description": "Các giá trị hợp lệ: PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | COMPLETED | CANCELLED | RETURNED | REFUNDED"
                }
              ]
            }
          }
        },
        {
          "name": "5b. Update Order Status → PROCESSING",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders/{{orderId}}/status?status=PROCESSING",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "status"],
              "query": [{ "key": "status", "value": "PROCESSING" }]
            }
          }
        },
        {
          "name": "5c. Update Order Status → DELIVERED",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders/{{orderId}}/status?status=DELIVERED",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "status"],
              "query": [{ "key": "status", "value": "DELIVERED" }]
            }
          }
        },
        {
          "name": "6. Cancel Order (chỉ được khi PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "// Lưu ý: request này sẽ thất bại nếu đơn hàng không ở trạng thái PENDING"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{customerId}}", "description": "Phải là chủ đơn hàng" }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders/{{orderId}}/cancel",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "cancel"]
            }
          }
        },
        {
          "name": "— ERROR: Get Order Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders/00000000-0000-0000-0000-999999999999",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders", "00000000-0000-0000-0000-999999999999"]
            }
          }
        },
        {
          "name": "— ERROR: Create Order — thiếu items (validation fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{customerId}}" }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"123 Nguyễn Huệ, Quận 1, TP.HCM\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Payment Service",
      "description": "Tất cả endpoint của Payment Service (port 8086). \nChạy AFTER khi đã có orderId từ Order Service.",
      "item": [
        {
          "name": "1. Create Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Tự động lưu paymentId vào biến collection",
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('paymentId', res.data.id);",
                  "    console.log('paymentId đã được set:', res.data.id);",
                  "}",
                  "",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Payment ở trạng thái PENDING', () => {",
                  "    pm.expect(res.data.status).to.equal('PENDING');",
                  "    pm.expect(res.data.transactionId).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
