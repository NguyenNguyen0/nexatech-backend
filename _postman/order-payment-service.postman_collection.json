            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": 250000,\n  \"method\": \"BANK_TRANSFER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Tạo giao dịch thanh toán cho đơn hàng.\n\nmethod hợp lệ: COD | BANK_TRANSFER | MOMO | VNPAY | CREDIT_CARD"
          }
        },
