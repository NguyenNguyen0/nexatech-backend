    {
      "name": "E2E Flow: Đặt hàng → Thanh toán → Xác nhận → Hoàn tiền",
      "description": "Chạy tuần tự các request này để test full happy path:\n1. Tạo đơn hàng (PENDING)\n2. Tạo thanh toán (PENDING)\n3. Admin xác nhận đơn → ORDER_STATUS_UPDATED event → Kafka → Payment tự COMPLETED\n4. Hoàn tiền\n\nLưu ý bước 3: payment sẽ tự chuyển COMPLETED qua Kafka consumer nếu Kafka đang chạy.",
      "item": [
        {
          "name": "Step 1 — Tạo đơn hàng mới",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('orderId', res.data.id);",
                  "    console.log('[E2E] orderId:', res.data.id);",
                  "}",
                  "pm.test('[E2E] Đặt hàng thành công', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(res.data.status).to.equal('PENDING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{customerId}}" }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId1}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": \"456 Lê Lợi, Quận 3, TP.HCM\",\n  \"note\": \"E2E Test order\"\n}"
            }
          }
        },
        {
          "name": "Step 2 — Tạo thanh toán cho đơn hàng",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('paymentId', res.data.id);",
                  "    console.log('[E2E] paymentId:', res.data.id);",
                  "}",
                  "pm.test('[E2E] Tạo thanh toán thành công', () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(res.data.status).to.equal('PENDING');",
                  "    pm.expect(res.data.orderId).to.equal(pm.collectionVariables.get('orderId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{customerId}}" }
            ],
            "url": {
              "raw": "{{paymentBaseUrl}}/api/v1/payments",
              "host": ["{{paymentBaseUrl}}"],
              "path": ["api", "v1", "payments"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": 150000,\n  \"method\": \"VNPAY\"\n}"
            }
          }
        },
        {
          "name": "Step 3 — Admin xác nhận đơn hàng (trigger Kafka event)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[E2E] Xác nhận đơn hàng thành công', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.status).to.equal('CONFIRMED');",
                  "});",
                  "console.log('[E2E] ORDER_STATUS_UPDATED(CONFIRMED) event đã được publish lên Kafka.');",
                  "console.log('[E2E] PaymentEventConsumer sẽ tự động set payment -> COMPLETED.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{orderBaseUrl}}/api/v1/orders/{{orderId}}/status?status=CONFIRMED",
              "host": ["{{orderBaseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "status"],
              "query": [{ "key": "status", "value": "CONFIRMED" }]
            }
          }
        },
        {
          "name": "Step 4 — Kiểm tra payment đã COMPLETED (qua Kafka)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[E2E] Payment đã được xác nhận qua Kafka', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    // Status phải là COMPLETED nếu Kafka consumer đã xử lý",
                  "    pm.expect(res.data.status).to.equal('COMPLETED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{paymentBaseUrl}}/api/v1/payments/{{paymentId}}",
              "host": ["{{paymentBaseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}"]
            },
            "description": "Nếu Kafka đang chạy, payment sẽ tự động chuyển COMPLETED sau khi nhận ORDER_STATUS_UPDATED event."
          }
        },
        {
          "name": "Step 5 — Hoàn tiền",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[E2E] Hoàn tiền thành công', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.data.status).to.equal('REFUNDED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{paymentBaseUrl}}/api/v1/payments/{{paymentId}}/refund",
              "host": ["{{paymentBaseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}", "refund"]
            }
          }
        }
      ]
    }
  ]
}
