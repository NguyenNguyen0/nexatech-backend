# Sao chép thành .env và điền giá trị. Không commit file .env.

CONFIG_SERVER_URI=http://localhost:8888
KEYCLOAK_ISSUER_URI=http://localhost:9000/realms/your-realm
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
GATEWAY_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Optional route overrides for local/direct routing
IDENTITY_SERVICE_URI=lb://identity-service
CHAT_SERVICE_URI=lb://chat-service
CHAT_SERVICE_WS_URI=lb://chat-service
PROMOTION_SERVICE_URI=lb://promotion-service
AGENT_SERVICE_URI=lb://agent-service

# Tùy chọn: ghi đè port (mặc định lấy từ config-server)
SERVER_PORT=
