# Sao chép thành .env và điền giá trị. Không commit file .env.

CONFIG_SERVER_URI=http://localhost:8888

EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexatech_users
DATASOURCE_USERNAME=your_db_username
DATASOURCE_PASSWORD=your_db_password

KEYCLOAK_ISSUER_URI=http://localhost:9000/realms/your-realm

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=user-service-group
AUDIT_LOG_TOPIC=audit-topic

# URL đầy đủ tới identity-service (port theo cấu hình của bạn)
IDENTITY_SERVICE_URL=http://localhost:8082

# AWS S3 — upload ảnh đại diện (cùng bucket/keys với product-service)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
