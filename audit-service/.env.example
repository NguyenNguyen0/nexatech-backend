# Sao chép thành .env và điền giá trị. Không commit file .env.

# --- Config Server & Eureka ---
CONFIG_SERVER_URI=http://localhost:8888

EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

# --- MongoDB (database: nexatech_audit) ---
MONGO_AUDIT_URL=mongodb://your_user:your_password@localhost:27017/nexatech_audit?authSource=admin&authMechanism=SCRAM-SHA-256

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=audit-service-group
AUDIT_LOG_TOPIC=audit-topic

# --- Keycloak (OAuth2 resource server) ---
KEYCLOAK_ISSUER_URI=http://localhost:9000/realms/your-realm

# Requires config-server (launch "config-server" first). Port 8096 comes from configs/audit-service.yml.
