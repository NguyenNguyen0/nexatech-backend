# Copy to .env and fill real values. Do not commit .env.

CONFIG_SERVER_URI=http://localhost:8888

# Eureka / Discovery
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
EUREKA_INSTANCE_IP_ADDRESS=127.0.0.1

# MongoDB: nexatech_audit
SPRING_MONGODB_URI=mongodb://your_user:your_password@localhost:27017/nexatech_audit?authSource=admin&authMechanism=SCRAM-SHA-256

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=audit-service-group
AUDIT_LOG_TOPIC=audit-topic

# Keycloak resource server
KEYCLOAK_ISSUER_URI=http://localhost:9000/realms/nexatech
