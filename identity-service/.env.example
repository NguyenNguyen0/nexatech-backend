# Sao chép thành .env và điền giá trị. Không commit file .env.

CONFIG_SERVER_URI=http://localhost:8888

EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

KEYCLOAK_ISSUER_URI=http://localhost:9000/realms/your-realm
KEYCLOAK_URL=http://localhost:9000
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=identity-service-group

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# URL đầy đủ tới user-service (port theo cấu hình của bạn)
OPENFEIGN_USER_SERVICE_URL=http://localhost
