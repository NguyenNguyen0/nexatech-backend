# Sao chép thành .env và điền giá trị. Không commit file .env.

CONFIG_SERVER_URI=http://localhost:8888

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexatech_payments
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

# VNPay Sandbox credentials
# Copy this file to .env and fill in your values
# Get credentials at: https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# VNPay portal URL (sandbox - no need to change)
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Return URL: browser redirect after payment - point to your frontend
# Production example: https://yourdomain.com/payment/result
VNPAY_RETURN_URL=http://localhost:3000/payment/result

# IPN URL: server-to-server callback from VNPay - MUST be publicly accessible
# For local testing: use ngrok -> ngrok http 8086
# Then set: VNPAY_IPN_URL=https://<your-ngrok-id>.ngrok-free.app/api/v1/payments/vnpay/ipn
VNPAY_IPN_URL=
