# VNPay Sandbox credentials
# Copy this file to .env and fill in your values
# Get credentials at: https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# VNPay portal URL (sandbox - no need to change)
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Return URL: browser redirect after payment - point to your frontend
# Production example: https://yourdomain.com/payment/result
VNPAY_RETURN_URL=http://localhost:3000/payment/result

# IPN URL: server-to-server callback from VNPay - MUST be publicly accessible
# For local testing: use ngrok -> ngrok http 8086
# Then set: VNPAY_IPN_URL=https://<your-ngrok-id>.ngrok-free.app/api/v1/payments/vnpay/ipn
VNPAY_IPN_URL=
