# ============================================================
# order-service .env.example — copy to .env and fill in values
# ============================================================

# Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexatech_orders
DB_USERNAME=nexatech
DB_PASSWORD=nexatech123

# Feign direct URLs (dùng khi không có Eureka)
inventory-service.url=http://localhost:8085
product-service.url=http://localhost:8090
payment-service.url=http://localhost:8086

# Eureka (false = không cần discovery-server)
eureka.client.enabled=false
eureka.client.register-with-eureka=false
eureka.client.fetch-registry=false
