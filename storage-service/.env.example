# Sao chép thành .env và điền giá trị. Không commit file .env.

CONFIG_SERVER_URI=http://localhost:8888

EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

MINIO_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=aws-s3-node-app
MINIO_REGION=ap-southeast-1
MINIO_PATH_STYLE_ACCESS_ENABLED=false
MINIO_USE_DIRECT_S3_URL=true
MINIO_PUBLIC_URL=