# ====================================
# Database
# ====================================
POSTGRES_USER=nexatech
POSTGRES_PASSWORD=nexatech123

MONGO_USER=nexatech
MONGO_PASSWORD=nexatech123
# Atlas example:
# MONGO_PRODUCT_URL=mongodb+srv://<user>:<password>@<cluster-url>/nexatech_products?retryWrites=true&w=majority&appName=nexatech-product
# Local Docker Mongo example:
# MONGO_PRODUCT_URL=mongodb://nexatech:nexatech123@mongodb:27017/nexatech_products?authSource=admin
MONGO_PRODUCT_URL=mongodb://nexatech:nexatech123@mongodb:27017/nexatech_products?authSource=admin

# ====================================
# JWT
# ====================================
JWT_SECRET=your-very-long-random-secret-key-at-least-256-bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ====================================
# Mail (Gmail App Password)
# ====================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ====================================
# MinIO / AWS S3 (storage-service)
# For local MinIO: MINIO_ENDPOINT=http://minio:9000, MINIO_PUBLIC_URL=http://localhost:8000
# For AWS S3:      MINIO_ENDPOINT=https://s3.<region>.amazonaws.com
# ====================================
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=nexatech-minio
MINIO_SECRET_KEY=nexatech-minio-secret
MINIO_BUCKET=nexatech-products
MINIO_PUBLIC_URL=http://localhost:8000

# ====================================
# Shipping (GHN)
# ====================================
SHIPPING_PROVIDER=ghn
GHN_TOKEN=your-ghn-token
GHN_SHOP_ID=your-ghn-shop-id
GHN_FROM_DISTRICT_ID=your-district-id
GHN_FROM_WARD_CODE=your-ward-code
GHN_FROM_DISTRICT_NAME=Thành phố Thủ Đức
GHN_FROM_WARD_NAME=Linh Trung

# ====================================
# VNPay
# ====================================
VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8086/api/v1/payments/vnpay/return
VNPAY_IPN_URL=https://your-devtunnel-url/api/v1/payments/vnpay/ipn
