# ============================================================
# inventory-service .env.example — copy to .env and fill in values
# ============================================================

# Port
server.port=8085

# Postgres
DB_HOST=localhost
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexatech_inventory
DB_USERNAME=nexatech
DB_PASSWORD=nexatech123

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
SPRING_DATA_REDIS_HOST=localhost

# Eureka (false = không cần discovery-server)
eureka.client.enabled=false
eureka.client.register-with-eureka=false
eureka.client.fetch-registry=false
