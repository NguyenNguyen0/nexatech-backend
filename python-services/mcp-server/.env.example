# MCP server runtime
SERVICE_NAME=mcp-server
PORT=8094
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=5

# Eureka registration
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://localhost:8761/eureka/
# Set explicit hostname/IP if auto-detection is wrong in your environment
EUREKA_INSTANCE_HOSTNAME=127.0.0.1

# Downstream service base URLs
NEWS_SERVICE_BASE_URL=http://localhost:8092
INVENTORY_SERVICE_BASE_URL=http://localhost:8085
ORDER_SERVICE_BASE_URL=http://localhost:8084
PAYMENT_SERVICE_BASE_URL=http://localhost:8086
AUDIT_SERVICE_BASE_URL=http://localhost:8096
PROMOTION_SERVICE_BASE_URL=http://localhost:8093

# Downstream health endpoints
NEWS_SERVICE_HEALTH_PATH=/actuator/health
INVENTORY_SERVICE_HEALTH_PATH=/actuator/health
ORDER_SERVICE_HEALTH_PATH=/actuator/health
PAYMENT_SERVICE_HEALTH_PATH=/actuator/health
AUDIT_SERVICE_HEALTH_PATH=/actuator/health
PROMOTION_SERVICE_HEALTH_PATH=/health

# Resilience tuning for downstream calls
SERVICE_REQUEST_TIMEOUT_SECONDS=5
SERVICE_RETRY_ATTEMPTS=3
SERVICE_RETRY_BACKOFF_SECONDS=0.25
SERVICE_RETRY_MAX_BACKOFF_SECONDS=2.0

# Default user context for internal downstream calls (dev default)
MCP_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
MCP_DEFAULT_USER_EMAIL=dev@nexatech.local
