# Agent service runtime
SERVICE_NAME=agent-service
PORT=8097
LOG_LEVEL=INFO

# Eureka registration
EUREKA_ENABLED=true
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=127.0.0.1

# MCP server endpoint
# IMPORTANT: Use MCP server base URL only (without /mcp suffix)
MCP_SERVER_URL=http://localhost:8094
REQUEST_TIMEOUT_SECONDS=8

# LangSmith / tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexatech-agent

# Groq model provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1

# CopilotKit runtime identity
AGUI_AGENT_NAME=nexatech_agent
AGUI_AGENT_DESCRIPTION=NexaTech admin agent — news, analytics, audit, promotions

# LangGraph checkpointer DB
AGENT_DB_URL=postgresql://nexatech:nexatech123@localhost:5432/nexatech_agent

# Conversation persistence (MongoDB)
CONVERSATION_STORE_ENABLED=true
MONGO_URI=mongodb://nexatech:nexatech123@localhost:27017/?authSource=admin
MONGO_DATABASE=nexatech_agent
MONGO_CONVERSATION_COLLECTION=conversation_sessions
CONVERSATION_HISTORY_MAX_EVENTS=500

# HITL timeout defaults
APPROVAL_TIMEOUT_SECONDS=600
ESCALATION_TIMEOUT_SECONDS=900
